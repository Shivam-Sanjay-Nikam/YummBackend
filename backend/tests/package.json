{
  "name": "yuum-backend-tests",
  "version": "1.0.0",
  "description": "Comprehensive End-to-End Test Suite for Yuum Backend",
  "main": "e2e-tests.js",
  "scripts": {
    "setup": "node setup.js",
    "test": "node e2e-tests.js",
    "test:verbose": "node e2e-tests.js --verbose",
    "test:debug": "node e2e-tests.js --debug",
    "test:report": "node e2e-tests.js --report",
    "test:auth": "node e2e-tests.js --category=authentication",
    "test:user-mgmt": "node e2e-tests.js --category=user-management",
    "test:menu": "node e2e-tests.js --category=menu-management",
    "test:orders": "node e2e-tests.js --category=order-management",
    "test:security": "node e2e-tests.js --category=security",
    "test:validation": "node e2e-tests.js --category=validation",
    "test:no-cleanup": "node e2e-tests.js --no-cleanup",
    "test:full": "npm run setup && npm test"
  },
  "keywords": [
    "testing",
    "e2e",
    "supabase",
    "edge-functions",
    "backend",
    "api"
  ],
  "author": "Yuum Backend Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/yuum-backend"
  },
  "bugs": {
    "url": "https://github.com/your-org/yuum-backend/issues"
  },
  "homepage": "https://github.com/your-org/yuum-backend#readme"
}
